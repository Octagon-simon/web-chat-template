# Server (never exposed to the browser)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SYSTEM_PROMPT=
PORT=8787

# Client (baked in at build time, safe to expose)
VITE_BRAND=Chat
VITE_HEADLINE=What are you working on?
VITE_PLACEHOLDER=Ask anything
VITE_DISCLAIMER=Model output can be wrong. Verify anything that matters.
VITE_SUGGESTIONS=Summarize a long document,Write a regex I can trust,Explain this error message
VITE_PROVIDER_LABEL=OpenAI-compatible
VITE_MODEL=gpt-4o-mini
VITE_MODELS=gpt-4o-mini:GPT-4o mini,gpt-4.1-mini:GPT-4.1 mini,llama3.1:8b:Llama 3.1 8B (local)

# Optional: show store buttons on the Mobile app page once you have listings
VITE_IOS_STORE_URL=
VITE_ANDROID_STORE_URL=
